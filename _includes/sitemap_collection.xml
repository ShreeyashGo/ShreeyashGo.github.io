{% for link in include.links %}
  {% assign extension = link.url | split: '.' | last %}
  {% assign last_character = link.url | slice: -1, 1 %}
  {% assign is_html = false %}
  {% if last_character == '/' or extension == 'html' %}{% assign is_html = true %}{% endif %}
  {% unless link.sitemap == false or link.sitemap.exclude == true or link.published == false or link.noindex == true or link.layout == 'redirect' or link.layout == 'blog' %}
    {% if is_html %}
    <url>
      <loc>{{ site.url }}{{ site.baseurl }}{{ link.url | remove: 'index.html' | xml_escape }}</loc>
      {% if link.sitemap.lastmod %}
      <lastmod>{{ link.sitemap.lastmod | date: '%Y-%m-%d' }}</lastmod>
      {% elsif link.last_modified_at %}
      <lastmod>{{ link.last_modified_at | date_to_xmlschema }}</lastmod>
      {% elsif link.date %}
      <lastmod>{{ link.date | date_to_xmlschema }}</lastmod>
      {% endif %}
    </url>
    {% endif %}
  {% endunless %}
{% endfor %}
